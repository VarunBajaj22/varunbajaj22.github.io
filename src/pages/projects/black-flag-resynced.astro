---
import BaseLayout from '../../layouts/BaseLayout.astro';

const trailers = [
  { id: 'WjsTLe7bBUA', title: "Assassin's Creed Black Flag Resynced: World Premiere Trailer" },
  { id: 'PhQ3yQjUgAc', title: "Assassin's Creed Black Flag Resynced: Official Game Overview Trailer" },
  { id: 'U9EmVkQ5v54', title: "Assassin's Creed Black Flag Resynced: Official Summer Game Fest Trailer" },
  { id: 'PuC4vB0kLvw', title: "Assassin's Creed Black Flag Resynced: Horizon Launch Trailer (2026)" },
];

---

<BaseLayout title="Varun Bajaj | Assassin's Creed Black Flag Resynced" description="Mission and location design work on Assassin's Creed Black Flag Resynced.">
  <section class="section" style="padding-top: calc(var(--nav-height) + 3rem);">
    <div class="container">
      <div class="section-header fade-in">
        <h1 class="section-title" style="font-size: clamp(2rem, 5vw, 3rem);">Assassin's Creed Black Flag Resynced</h1>
        <p class="section-description">Worked as a Quest Designer/ Level Designer at Ubisoft India in collaboration with Ubisoft Singapore, Ubisoft Barcelona, Ubisoft Belgrade, Ubisoft Bordeaux, Ubisoft Bucharest, Ubisoft Chengdu, Ubisoft Da Nang, Ubisoft Kyiv, Ubisoft Montpellier, Ubisoft Montréal, Ubisoft Philippines, Ubisoft Québec, Ubisoft Shanghai and Ubisoft Sofia!</p>
        <p class="section-description project-detail">Worked on the mission design of golden path main quests and side missions/activities, and the level design of locations in the world including layouts, parkour, events, activities and encounters.</p>
      </div>
      <div class="trailer-grid">
        {trailers.map(trailer => (
          <article class="card trailer-card fade-in">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${trailer.id}`}
              title={trailer.title}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            />
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .project-detail {
    margin-top: 0.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .trailer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 1.5rem;
  }

  .trailer-card iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    background: #000;
  }
</style>